# 必填：模型服务提供商的 API Key。不要将真实密钥提交到代码仓库。
OPENAI_API_KEY=

# 模型服务地址与模型名称必须成对配置（需兼容 OpenAI Responses API）。
# 下面按 OpenAI 官方服务填写；留空时 BASE_URL 走 SDK 默认值 https://api.openai.com/v1，
# 模型名称留空则使用程序默认值 deepseek-flash，两者不一定匹配，建议显式填写。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Agent 获准访问的项目工作区根目录。
WORKSPACE_ROOT=C:\\CodeAgentWorkspace

# 本地数据目录和 Skill 目录。相对路径以程序启动时的工作目录为基准解析
# （从项目根目录执行 go run ./cmd/codeagent 时即为项目根目录）。
DATA_DIR=./data
SKILLS_DIR=./skills
MCP_CONFIG=./configs/mcp_servers.json


# 会话消息条目达到此数量后，自动生成会话摘要。
SUMMARY_THRESHOLD=40
